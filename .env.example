# LeadsGen configuration. Copy to `.env` in the repo root (or services/api/.env).
# Every value has a safe local default except where marked REQUIRED IN PRODUCTION.

# --- App ----------------------------------------------------------------------------------
ENVIRONMENT=development            # development | test | production
APP_NAME=LeadsGen
LOG_LEVEL=INFO
# LOG_JSON=true                    # JSON logs; defaults to on outside development/test

# --- Database & Redis ---------------------------------------------------------------------
# SQLite by default for local development. PostgreSQL is REQUIRED IN PRODUCTION.
# DATABASE_URL=postgresql://user:password@localhost:5432/leadsgen
REDIS_URL=redis://localhost:6379/0

# --- Security (REQUIRED IN PRODUCTION) ----------------------------------------------------
# At least 32 random characters:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
# Fernet key for provider credentials stored in the database:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_ENCRYPTION_KEY=
# Key rotation: comma-separated, newest first (overrides SECRET_ENCRYPTION_KEY when set).
# SECRET_ENCRYPTION_KEYS=new-key,old-key
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# --- URLs ---------------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000     # used in verification / reset / invitation links
API_PUBLIC_URL=http://localhost:8000   # used in unsubscribe links (must be public https in prod)
CORS_ORIGINS=http://localhost:3000     # comma-separated, explicit origins only
EXPOSE_API_DOCS=true                   # /docs; turn off in production if you prefer

# --- Sessions -----------------------------------------------------------------------------
# The web app proxies /api/* to the API, so the refresh cookie is first-party.
REFRESH_COOKIE_PATH=/api/auth
REFRESH_COOKIE_SAMESITE=lax
REQUIRE_EMAIL_VERIFICATION=true
# Reject passwords found in known breaches (Have I Been Pwned, k-anonymity; skipped if unreachable)
PASSWORD_BREACH_CHECK=true
# Cloudflare Turnstile CAPTCHA (sign-up, password reset, repeated failed logins). Empty = off.
TURNSTILE_SECRET_KEY=
TRUSTED_PROXY_HOPS=1

# --- Platform email (verification, password reset, invitations; never outreach) -----------
PLATFORM_EMAIL_PROVIDER=console        # console (logs only) | resend | smtp  — not console in prod
PLATFORM_EMAIL_FROM=LeadsGen <no-reply@example.com>
PLATFORM_EMAIL_API_KEY=                # Resend API key
# PLATFORM_SMTP_HOST=
# PLATFORM_SMTP_PORT=587
# PLATFORM_SMTP_USERNAME=
# PLATFORM_SMTP_PASSWORD=
# PLATFORM_SMTP_USE_TLS=true          # false for a local catcher such as Mailpit
SUPPORT_EMAIL=support@example.com     # contact form and feedback land here

# --- Platform-paid services (optional) ---------------------------------------------------
# Used only when a workspace hasn't connected its own key, and counted against its plan.
# Workspaces that bring their own keys are never metered for that service.
# PLATFORM_VERIFICATION_PROVIDER=     # zerobounce | neverbounce
# PLATFORM_VERIFICATION_API_KEY=
# HUNTER_ENABLED=false
# EMAIL_DISCOVERY_PROVIDER=hunter
# HUNTER_API_KEY=

# --- Inbound email ------------------------------------------------------------------------
# Domain whose MX points at your inbound webhook provider, for reply+TOKEN@ and
# unsubscribe+TOKEN@ addresses. Leave empty to rely on In-Reply-To matching only.
INBOUND_EMAIL_DOMAIN=

# --- Feature flags (dark launch) ----------------------------------------------------------
FEATURE_AI_EMAILS=false
FEATURE_IMAP=false
FEATURE_INBOUND_WEBHOOKS=false
FEATURE_SSO=false
FEATURE_PUBLIC_API=false               # /v1 REST API, API keys and outbound webhooks (docs/API.md)
FEATURE_BILLING=false                  # Stripe plans and trials; needs the STRIPE_* values below
FEATURE_MAILBOX_OAUTH=false            # connect Gmail / Microsoft 365 mailboxes (docs/PROVIDERS.md)
FEATURE_CRM=false                      # deals, tasks and notes (docs/CRM.md)
FEATURE_ANALYTICS_V2=false             # analytics page and weekly report additions (docs/ANALYTICS.md)
FEATURE_INTEGRATIONS=false             # HubSpot and Pipedrive sync (docs/INTEGRATIONS.md)

# --- Billing (Stripe, see docs/BILLING.md) ------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price ids per plan and interval, e.g. {"starter:month": "price_...", "starter:year": "price_...", "pro:month": "price_..."}
STRIPE_PRICES={}
STRIPE_AUTOMATIC_TAX=false
BILLING_TRIAL_DAYS=14
BILLING_GRACE_DAYS=7                   # days past due before sending pauses
# Prices shown on the public pricing page (whole currency units; "year" is the yearly total)
PLAN_DISPLAY_PRICES={"currency": "USD", "free": {"month": 0, "year": 0}, "starter": {"month": 39, "year": 390}, "pro": {"month": 99, "year": 990}}
# Credit packs (display prices) and their Stripe one-time prices; see docs/BILLING.md
CREDIT_PACKS=[{"credits": 1000, "amount": 10}, {"credits": 5000, "amount": 40}, {"credits": 20000, "amount": 120}]
STRIPE_CREDIT_PRICES={}

# --- Back office and API ------------------------------------------------------------------
SUPERUSER_REQUIRE_MFA=true             # superusers must have two-factor on to use /admin
IMPERSONATION_MAX_MINUTES=60
RATE_LIMIT_API=120/minute              # per API key
OUTBOUND_WEBHOOK_TIMEOUT_SECONDS=10

# --- Sign in with Google / Microsoft (see docs/SSO.md) ------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=

# --- CRM integrations (see docs/INTEGRATIONS.md) -----------------------------------------
# HubSpot public app; redirect URL: <FRONTEND_URL>/api/integrations/oauth/hubspot/callback
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=

# --- AI (optional) ------------------------------------------------------------------------
# Platform-paid model used when a workspace hasn't added its own key; counted against the
# plan's monthly token allowance. groq | openai | gemini | "" (off). Never "mock" in prod.
PLATFORM_LLM_PROVIDER=
PLATFORM_LLM_API_KEY=
PLATFORM_LLM_MODEL=
LLM_TIMEOUT_SECONDS=30

# --- Sending defaults ---------------------------------------------------------------------
DEFAULT_DAILY_SEND_LIMIT=20
DEFAULT_PER_DOMAIN_LIMIT=3
DEFAULT_SENDING_WINDOW_START=09:00
DEFAULT_SENDING_WINDOW_END=17:00

# --- Enrichment ---------------------------------------------------------------------------
ENRICHMENT_USER_AGENT=LeadsGenBot/0.1 (B2B enrichment; respects robots.txt)
ENRICHMENT_REQUEST_TIMEOUT=10
ENRICHMENT_RATE_LIMIT_SECONDS=1.0
ENRICHMENT_MAX_PAGES=3

# --- File storage (exports) --------------------------------------------------------------
# local (disk; development only, lost on redeploy) | s3 (AWS S3, Cloudflare R2, MinIO)
STORAGE_BACKEND=local
# STORAGE_LOCAL_DIR=                   # defaults to services/api/data/storage
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- Rate limiting ------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
# RATE_LIMIT_STORAGE_URL=             # defaults to REDIS_URL outside development/test

# --- Observability ------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
# OpenTelemetry traces over OTLP/HTTP (Grafana Tempo, Honeycomb, Datadog...)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SAMPLE_RATIO=0.1
# Bearer token for GET /metrics (Prometheus). Empty disables the endpoint.
METRICS_TOKEN=
# PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus   # needed with several uvicorn workers

# --- Web app (apps/web) -------------------------------------------------------------------
# Where Next.js proxies /api/* — the API's private URL on Railway, localhost:8000 locally.
API_INTERNAL_URL=http://localhost:8000
# Browser error reporting (Sentry). Source maps upload when SENTRY_AUTH_TOKEN/ORG/PROJECT are set at build.
NEXT_PUBLIC_SENTRY_DSN=
# Turnstile site key (public), paired with TURNSTILE_SECRET_KEY on the API
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
# Public site: canonical URL for SEO, legal entity shown on the legal pages, contact addresses
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_LEGAL_ENTITY=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_PRIVACY_EMAIL=
NEXT_PUBLIC_STATUS_URL=
# Product analytics (PostHog), only loaded after cookie consent
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
