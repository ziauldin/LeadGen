{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "leadgen",
	"main": ".open-next/worker.js",
	"compatibility_date": "2025-01-01",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	// WORKER_SELF_REFERENCE is omitted because open-next.config.ts uses
	// queue: "direct" — revalidation runs inline, no self-call needed.
	// Re-add it (with a matching service name) only if you switch to the
	// default queue and add an R2 incremental cache bucket.
	//
	// Optional R2 incremental cache (better ISR across deploys):
	// 1. npx wrangler r2 bucket create leadgen-opennext-cache
	// 2. Uncomment below and remove queue:"direct" from open-next.config.ts
	// "r2_buckets": [{ "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "leadgen-opennext-cache" }],
	// "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "leadgen" }],
	"observability": {
		"enabled": true
	}
}
